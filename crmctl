#!/bin/bash

# CRM Maroc Control Script - Simple version
# Usage: ./crmctl {start|stop|restart|status}

SERVICE_NAME="crm-maroc"
SERVICE_FILE="/etc/systemd/system/${SERVICE_NAME}.service"

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Check if service is installed
check_service() {
    if [[ ! -f "$SERVICE_FILE" ]]; then
        echo -e "${RED}Service not installed. Run: sudo ./crm-service.sh install${NC}"
        exit 1
    fi
}

# Start service
start() {
    check_service
    echo -e "${GREEN}Starting CRM Maroc service...${NC}"
    sudo systemctl start "$SERVICE_NAME"
    
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ Service started successfully!${NC}"
        echo -e "${GREEN}Access your application at: http://$(hostname -I | awk '{print $1}'):8000${NC}"
    else
        echo -e "${RED}✗ Failed to start service${NC}"
        sudo systemctl status "$SERVICE_NAME" --no-pager -l
        exit 1
    fi
}

# Stop service
stop() {
    check_service
    echo -e "${YELLOW}Stopping CRM Maroc service...${NC}"
    sudo systemctl stop "$SERVICE_NAME"
    
    if ! systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ Service stopped successfully!${NC}"
    else
        echo -e "${RED}✗ Failed to stop service${NC}"
        exit 1
    fi
}

# Restart service
restart() {
    check_service
    echo -e "${YELLOW}Restarting CRM Maroc service...${NC}"
    sudo systemctl restart "$SERVICE_NAME"
    
    if systemctl is-active --quiet "$SERVICE_NAME"; then
        echo -e "${GREEN}✓ Service restarted successfully!${NC}"
        echo -e "${GREEN}Access your application at: http://$(hostname -I | awk '{print $1}'):8000${NC}"
    else
        echo -e "${RED}✗ Failed to restart service${NC}"
        sudo systemctl status "$SERVICE_NAME" --no-pager -l
        exit 1
    fi
}

# Show status
status() {
    check_service
    echo -e "${GREEN}CRM Maroc Service Status:${NC}"
    echo "----------------------------------------"
    sudo systemctl status "$SERVICE_NAME" --no-pager -l
    
    echo "----------------------------------------"
    if netstat -tlnp 2>/dev/null | grep -q ":8000 "; then
        echo -e "${GREEN}✓ Port 8000 is listening${NC}"
        netstat -tlnp 2>/dev/null | grep ":8000 "
    else
        echo -e "${YELLOW}⚠ Port 8000 is not listening${NC}"
    fi
}

# Show help
help() {
    echo "CRM Maroc Control Script"
    echo "Usage: $0 {start|stop|restart|status|help}"
    echo ""
    echo "Commands:"
    echo "  start   - Start the service"
    echo "  stop    - Stop the service"
    echo "  restart - Restart the service"
    echo "  status  - Show service status"
    echo "  help    - Show this help"
    echo ""
    echo "Examples:"
    echo "  ./crmctl start"
    echo "  ./crmctl status"
    echo "  ./crmctl restart"
}

# Main logic
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    help|--help|-h)
        help
        ;;
    *)
        echo -e "${RED}Invalid command: $1${NC}"
        echo ""
        help
        exit 1
        ;;
esac
